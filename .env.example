# Database
DATABASE_URL=sqlite+aiosqlite:///./data/prism.db

# Keycloak
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=prism-hub
KEYCLOAK_CLIENT_ID=prism-hub-backend
KEYCLOAK_CLIENT_SECRET=

# LLM (optional)
LLM_PROVIDER=
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=

# Demo mode (localhost only, never enable in production)
DEMO_MODE=false

# CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000